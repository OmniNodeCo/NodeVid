{
  "name": "nodevid",
  "version": "1.0.0",
  "private": true,
  "description": "A Netflix-style site for free, legal classic movies and TV: public-domain and Creative Commons titles streamed from the Internet Archive.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "serve": "npm run build && node server.js",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
